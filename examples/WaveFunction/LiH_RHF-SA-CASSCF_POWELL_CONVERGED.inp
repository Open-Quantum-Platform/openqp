# RHF/STO-3G/SA-CASSCF ENERGY of LiH in an inactive-core CAS(2e,2o) valence space.
# This native OpenQP example converges the equal-weight two-state
# state-average CASSCF objective with OpenQP-native FCI/RDM evaluations.
[input]
system=
   Li  0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   1.600000000
charge=0
runtype=energy
basis=sto-3g
method=sa-casscf

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=80
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=1
max_det=5000
max_memory=512

[ci]
nroot=2
solver=dense
eig_tol=1.0e-10
integral_backend=native
integral_cutoff=5.0e-11
davidson_maxiter=100

[state_average]
enabled=true
nstate=2
equal_weights=true
root_tracking=overlap

[casscf]
optimizer=powell
max_macro_iterations=80
gradient_norm_tol=5.0e-6
energy_decrease_tol=1.0e-12
step_norm_tol=1.0e-8
max_function_evaluations=8000
diagnostic_report=true
diagnostic_report_file=examples/WaveFunction/LiH_RHF-SA-CASSCF_POWELL_CONVERGED_MACRO.json
