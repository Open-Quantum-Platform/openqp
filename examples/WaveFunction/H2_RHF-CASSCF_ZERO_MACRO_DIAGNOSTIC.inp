# RHF/STO-3G/CASSCF scaffold ENERGY of H2 in the full CAS(2e,2o) space.
# This example intentionally keeps max_macro_iterations=0. It exercises the
# native fixed-orbital CASCI-backed CASSCF scaffold and writes a diagnostic-only
# CASSCF microiteration JSON sidecar; it is not an accepted orbital-optimized
# CASSCF calculation.
[input]
system=
   H   0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   0.740000000
charge=0
runtype=energy
basis=sto-3g
method=casscf

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=60
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=0
max_det=1000
max_memory=256

[ci]
nroot=1
solver=dense
eig_tol=1.0e-10
integral_backend=native
integral_cutoff=5.0e-11
davidson_maxiter=100

[casscf]
max_macro_iterations=0
diagnostic_report=true
diagnostic_root=0
diagnostic_max_iterations=1
diagnostic_gradient_norm_tol=1.0e-8
diagnostic_max_rotation_norm=5.0e-2
diagnostic_benchmark_reference_file=examples/WaveFunction/H2_RHF-CASSCF_ZERO_MACRO_DIAGNOSTIC_BENCHMARK.json
diagnostic_benchmark_tolerance=1.0e-7
diagnostic_benchmark_required=true
