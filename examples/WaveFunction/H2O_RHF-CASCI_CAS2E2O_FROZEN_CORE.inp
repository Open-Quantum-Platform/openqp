# RHF/STO-3G/CASCI/ENERGY of H2O in a CAS(2e,2o) frozen-core active space.
# Covers first-class [cas]/[ci] sections with a restricted active space.
[input]
system=
   O   0.000000000   0.000000000   0.117300000
   H   0.000000000   0.757200000  -0.469200000
   H   0.000000000  -0.757200000  -0.469200000
charge=0
runtype=energy
basis=sto-3g
method=casci

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=80
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=4
max_det=1000
max_memory=256

[ci]
nroot=1
solver=dense
eig_tol=1.0e-10
integral_backend=native
integral_cutoff=5.0e-11
davidson_maxiter=100
