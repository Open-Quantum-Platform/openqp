# RHF/STO-3G/CASSCF ENERGY of LiH in a frozen-core CAS(2e,2o) valence space.
# This is a native OpenQP state-specific CASSCF macroiteration smoke example:
# one accepted orbital step is committed to the live MO coefficients and the
# final CASSCF CI/RDM dependent state is recomputed from those orbitals.
[input]
system=
   Li  0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   1.600000000
charge=0
runtype=energy
basis=sto-3g
method=casscf

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=80
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=1
max_det=5000
max_memory=512

[ci]
nroot=1
solver=dense
eig_tol=1.0e-10
integral_backend=native
integral_cutoff=5.0e-11
davidson_maxiter=100

[casscf]
max_macro_iterations=1
root=0
gradient_norm_tol=1.0e-12
energy_decrease_tol=0.0
step_norm_tol=0.0
max_rotation_norm=5.0e-2
diagnostic_report=true
diagnostic_report_file=examples/WaveFunction/LiH_RHF-CASSCF_ONE_MACROITERATION_MACRO.json
