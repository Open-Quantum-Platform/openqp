# The DTCAM-TB operator written out as explicit [dftb] keys, WITHOUT
# model=dtcam-tb. This must reproduce BUTADIENE_DTCAMTB_ENERGY.inp digit for
# digit: the preset is resolved inside openqp-dftb from the same published
# vector these keys spell out (reference: plain DFTB2, no long-range term;
# a PLAIN DFTB2 reference (cam_alpha = cam_beta = 0, no long-range term);
# response LC erf (0, 1.0125, 0.32) inherited via lc_gamma; spin-W strengths
# 1.00/0.6375; SPC channels uniform 0.5; onsite pp -0.0125 Eh; Broyden
# 0.35/12/1.0 with tol 1e-8; Davidson response; Z-vector gradient).
# Expert use only: mixing these keys WITH model= is rejected by the checker.
[input]
system=
   6   0.605000   0.398000   0.000000
   6  -0.605000  -0.398000   0.000000
   6   1.832000  -0.116000   0.000000
   6  -1.832000   0.116000   0.000000
   1   0.472000   1.479000   0.000000
   1  -0.472000  -1.479000   0.000000
   1   2.725000   0.506000   0.000000
   1  -2.725000  -0.506000   0.000000
   1   1.992000  -1.193000   0.000000
   1  -1.992000   1.193000   0.000000
charge=0
runtype=energy
method=dftb
[scf]
type=rohf
multiplicity=3

[dftb]
type=mrsf
parameter_path=
lc_ground_state=False
lc_gamma=erf
omega=0.30
cam_alpha=0.0
cam_beta=0.0
w_scale=1.0
response_w_scale=0.6375
response_omega=0.32
response_cam_alpha=0.0
response_cam_beta=1.0125
spc_coco=0.5
spc_ovov=0.5
spc_coov=0.5
onsite_pp=-0.0125
scc_mixer=broyden
scc_mixing=0.35
scc_history=12
scc_max_step=1.0
scc_tolerance=1.0e-8
max_scc_iterations=4000
response_solver=davidson
[tdhf]
type=mrsf
nstate=3
