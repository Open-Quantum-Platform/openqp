# DTCAM-TB geometry optimization of physical S1 (the 1^1Bu+ bright state,
# singlet response root 2) of butadiene with the built-in optimizer.
[input]
system=
   6   0.605000   0.398000   0.000000
   6  -0.605000  -0.398000   0.000000
   6   1.832000  -0.116000   0.000000
   6  -1.832000   0.116000   0.000000
   1   0.472000   1.479000   0.000000
   1  -0.472000  -1.479000   0.000000
   1   2.725000   0.506000   0.000000
   1  -2.725000  -0.506000   0.000000
   1   1.992000  -1.193000   0.000000
   1  -1.992000   1.193000   0.000000
charge=0
runtype=optimize
method=dftb
[scf]
type=rohf
multiplicity=3

[dftb]
model=dtcam-tb
type=mrsf
parameter_path=
[tdhf]
type=mrsf
nstate=3
[optimize]
lib=oqp
istate=2
maxit=100
