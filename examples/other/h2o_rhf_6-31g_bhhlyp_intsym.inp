# Numerical guard for the XC symmetry reduction.
#
# [symmetry] use_integral_symmetry routes the density-driven XC path through
# get_sym_atom_weight, so the grid is reduced over the abelian atom orbits and
# the representative slices are scaled. That reduction had no numerical example
# behind it: the accompanying test inspects source text only and cannot detect a
# wrong XC energy or matrix.
#
# C2v water, so the two hydrogens form one orbit and the reduction genuinely
# engages (|G| = 4, abelian). The committed reference records both the energy
# and symmetry_metadata, so this deck fails if the reduced XC energy drifts AND
# if the reduction silently stops engaging.
[input]
system=
 8   0.000000000   0.000000000  -0.041061554
 1  -0.533194329   0.533194329  -0.614469223
 1   0.533194329  -0.533194329  -0.614469223
charge=0
method=hf
basis=6-31g
runtype=energy
functional=bhhlyp

[guess]
type=huckel
save_mol=False

[scf]
type=rhf
multiplicity=1
conv=1.0e-8
save_molden=False

[symmetry]
enabled=True
use_integral_symmetry=True
