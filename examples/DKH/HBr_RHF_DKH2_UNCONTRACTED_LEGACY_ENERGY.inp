# contracted x2c-TZVPall basis (ispher=true).
[input]
system=
   35   0.000000000   0.000000000   0.000000000
   1    0.000000000   0.000000000   1.407611000
charge=0
runtype=energy
basis=file:x2c-tzvpall_uncontracted_hbr.json
