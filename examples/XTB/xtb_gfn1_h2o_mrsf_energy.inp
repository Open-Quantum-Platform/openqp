# MRSF energy on the LC-GFN1-xTB reference with the optional OpenQP-xTB
# backend.
#
#    group   keyword          value
#  --------------------------------------
#    input   method           xtb
#    input   runtype          energy
#    tdhf    type             mrsf
#    xtb     type             mrsf
#    xtb     parameter_path   <converter-generated .opxtb file>
#
# The xTB backend is an optional external library (libopenqp_xtb_c); set
# [xtb] parameter_path to a converter-generated .opxtb parameter file
# (gfn1.opxtb below is a placeholder). Model options default to the full
# LC-GFN1 Hamiltonian: model=gfn1, dispersion/halogen_bond/third_order on,
# spin_scale=1.0, lc_gamma=ok with omega=0.3, cam_alpha=0, cam_beta=1.
#
# lc_ground_state=true opts the ground-state SCC into the long-range-corrected
# GFN1 kernel as well (default is false, which corrects only the response). This
# is the production LC-GFN1 configuration the MRSF reference is built on, so the
# opt-in flag is exercised here on the native backend.
[input]
system=
   8   0.000000000   0.000000000   0.000000000
   1   0.000000000   0.758602000   0.504284000
   1   0.000000000  -0.758602000   0.504284000
charge=0
runtype=energy
basis=sto-3g
functional=
method=xtb

[guess]
type=huckel

[scf]
type=rohf
multiplicity=3

[tdhf]
type=mrsf
nstate=3

[xtb]
backend=native
type=mrsf
parameter_path=gfn1.opxtb
lc_ground_state=true
