# UMRSF-TDDFT counterpart of examples/OPT/H2O_BHHLYP-MRSFTDDFT_OPTIMIZE.inp: same geometry and step limits,
# with a UHF triplet reference ([scf] type=uhf) and [tdhf] type=umrsf.  The SAP guess reaches the
# lowest UHF triplet here; the default Huckel guess converges to one 0.08 Hartree higher.
[input]
system=
   O  -0.0000000000   0.0000000000  -0.0410615540
   H  -0.5331943294   0.5331943294  -0.6144692230
   H   0.5331943294  -0.5331943294  -0.6144692230
charge=0
functional=bhhlyp
basis=6-31g*
runtype=optimize
method=tdhf

[guess]
type=sap

[scf]
type=uhf
multiplicity=3

[tdhf]
type=umrsf
nstate=2
maxit=30

[optimize]
istate=1
maxit=1
energy_shift=1
rmsd_grad=1
max_grad=1
rmsd_step=1
max_step=1

