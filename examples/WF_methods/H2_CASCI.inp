# RHF/STO-3G/CASCI/ENERGY of H2 in a full CAS(2e,2o) active space.
# Compact option-complete input for fixed-orbital active-space CI.
[input]
system=
   H   0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   0.740000000
charge=0
runtype=energy
basis=sto-3g
method=casci

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=60
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=0
active_orbital_indices=
core_orbital_indices=
orbital_source=rhf
orbital_file=
localize=none
sort_orbitals=energy
max_det=1000
max_memory=256

[ci]
nroot=1
solver=davidson
eig_tol=1.0e-10
davidson_maxiter=100
davidson_subspace=4
integral_backend=native
integral_cutoff=5.0e-11
spin_adapted=false
target_spin=any
root_tracking=energy
print_ci_vectors=false
ci_print_threshold=5.0e-2
save_ci_vectors=false
save_rdm=false
