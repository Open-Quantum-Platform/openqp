# RHF/STO-3G/XMCQDPT2 of linear H4, 2 singlet roots, CASCI reference.
# Granovsky's extended MCQDPT2 (JCP 134, 214113 (2011); GAMESS XZERO=.TRUE.):
# the reference states are first rotated to diagonalize the state-averaged Fock
# in the model space, then perturbed with one common diagonal-Fock H0 -- the
# invariant multistate QDPT, smooth near avoided crossings and conical
# intersections.  Same rotation + single-set machinery as method=xms-caspt2;
# only the conventions/labels differ.
[input]
system=
   H   0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   0.740000000
   H   0.000000000   0.000000000   1.480000000
   H   0.000000000   0.000000000   2.220000000
charge=0
runtype=energy
basis=sto-3g
method=xmcqdpt2

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=80
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=1
orbital_source=rhf
sort_orbitals=energy
max_det=5000
max_memory=512

[ci]
nroot=2
solver=dense
eig_tol=1.0e-10
integral_backend=native
target_spin=singlet

[pt2]
reference=casci
target_roots=0,1
nroot=2
ipea_shift=0.0
edshft=0.0
semi_canonical=true
