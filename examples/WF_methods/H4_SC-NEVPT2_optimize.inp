# RHF/STO-3G/SC-NEVPT2 geometry optimization of linear H4 driven by the
# ANALYTIC strongly contracted NEVPT2 nuclear gradient.
#
# This is the workflow check behind H4_SC-NEVPT2_grad.inp: an optimizer cannot
# converge on a gradient that is not the derivative of the energy it is
# minimizing, so reaching the convergence thresholds below is an end-to-end
# statement about the Lagrangian, the coupled orbital/CI response and the
# semicanonical response together -- not just about one number at one geometry.
#
# Measured: converged in 26 steps (about 2 s) with the native OQP optimizer,
# 26 analytic gradients and no displaced energies at all.  The
# central-difference alternative would have cost 26 x 6 x natom = 624
# SC-NEVPT2 energies for the same path.  Starting from a different bond length
# (0.76 A), and with a different optimizer library, both reach the same minimum
# energy to all ten printed digits -- the independent check that the optimizer
# is following a real surface rather than a self-consistent artefact.
#
#   E(SC-NEVPT2) at the optimized geometry = -2.2674421535
#   max |grad| < 1e-6 Hartree/Bohr  (threshold 3e-4)
#
# Single-state SC-NEVPT2 publishes one energy, so [optimize] istate=0 is the
# only valid selector; [pt2] target_roots picks which physical root fills it.
[input]
system=
   H   0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   0.740000000
   H   0.000000000   0.000000000   1.480000000
   H   0.000000000   0.000000000   2.220000000
charge=0
runtype=optimize
basis=sto-3g
method=caspt2

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
conv=1.0e-11
maxit=100
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[casscf]
# The Lagrangian assumes a stationary CASSCF reference and its error is first
# order in the residual orbital-rotation gradient, so this is what keeps the
# optimizer's search direction clean near the minimum.
gradient_norm_tol=1.0e-10
max_macro_iterations=300

[cas]
active_electrons=2
active_orbitals=2
frozen_core=1
orbital_source=rhf
sort_orbitals=energy
max_det=20000
max_memory=2048

[ci]
nroot=1
solver=dense
eig_tol=1.0e-12
integral_backend=native
target_spin=any

[optimize]
lib=oqp
maxit=60
istate=0

[pt2]
reference=casscf
variant=caspt2
h0=dyall
contraction=strong
gradient=analytic
frozen=0
semi_canonical=true
