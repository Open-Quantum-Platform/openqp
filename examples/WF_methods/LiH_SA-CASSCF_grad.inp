# RHF/STO-3G/SA-CASSCF central-difference nuclear gradient of the second
# published state of LiH, using orbitals optimized for an equal two-state average.
[input]
system=
   Li  0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   1.600000000
charge=0
runtype=grad
basis=sto-3g
method=sa-casscf

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=80
forced_attempt=3
save_molden=false

[properties]
grad=1
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=1
orbital_source=rhf
max_det=5000
max_memory=512

[ci]
nroot=2
solver=dense
eig_tol=1.0e-10
integral_backend=native
target_spin=singlet

[casscf]
max_macro_iterations=50
converger=trah
gradient_norm_tol=1.0e-10
energy_decrease_tol=1.0e-12
step_norm_tol=1.0e-10
max_rotation_norm=2.0e-1
canonicalize=true
grad_step=1.0e-3
grad_guess=cold
grad_gap_warn=1.0e-5
grad_ranks_per_group=0

[state_average]
enabled=true
weights=0.5,0.5
nstate=2
target_roots=0,1
equal_weights=true
