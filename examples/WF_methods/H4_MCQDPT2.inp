# RHF/STO-3G/MCQDPT2 of linear H4, 3 singlet roots, CASCI reference.
# GAMESS-convention multistate QDPT (Nakano): SINGLE-SET state-averaged
# canonical orbitals (IFORB=1 analogue), one common diagonal-Fock (MP-like) H0,
# ket-state-specific zeroth-order energies, symmetrized effective Hamiltonian.
# The determinant construction is the analogue of GAMESS MRPT=DETMRPT, which
# reproduces the CSF MCQDPT numbers for CAS references.
#
# The high third singlet is an intruder on the single-set path; the GAMESS
# intruder-state-avoidance shift ([pt2] edshft, EDSHFT: d -> d + edshft/d)
# regularizes it.  Set edshft=0.0 for plain MCQDPT2; edshft is mutually
# exclusive with level_shift/imaginary_shift.
[input]
system=
   H   0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   0.740000000
   H   0.000000000   0.000000000   1.480000000
   H   0.000000000   0.000000000   2.220000000
charge=0
runtype=energy
basis=sto-3g
method=mcqdpt2

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=80
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=1
orbital_source=rhf
sort_orbitals=energy
max_det=5000
max_memory=512

[ci]
nroot=3
solver=dense
eig_tol=1.0e-10
integral_backend=native
target_spin=singlet

[pt2]
reference=casci
target_roots=0,1,2
nroot=3
ipea_shift=0.0
edshft=0.02
semi_canonical=true
