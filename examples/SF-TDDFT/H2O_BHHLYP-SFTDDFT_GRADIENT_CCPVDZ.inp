# SF-TDDFT/cc-pVDZ/BHHLYP/GRADIENT of H2O: spherical-harmonic basis counterpart of H2O_BHHLYP-SFTDDFT_GRADIENT.inp
# For SF calculation, we have to choose multiplicity=3 and almost always [scf] type=rohf.
# Since this is a SF_TDDFT calculation, we have to set method=tdhf and to perform gradient calculation we
# have to set runtype=grad. This case requests grad=1 (the SF ground state) in [properties].
# grad=1 in TDDFT is S1 while for SF and MRSF, it is S0. So with MRSF you can calculate
# S0 state gradient.
[input]
system=
   8   0.000000000   0.000000000  -0.041061554
   1  -0.533194329   0.533194329  -0.614469223
   1   0.533194329  -0.533194329  -0.614469223
charge=0
runtype=grad
basis=cc-pvdz
functional=bhhlyp
method=tdhf

[guess]
type=huckel

[scf]
multiplicity=3
type=rohf

[tdhf]
type=sf
nstate=3

[properties]
grad=1

