# LC-corrected MRSF-TDDFTB energy with the erf-tuned long-range response
# operator (omega=0.25, cam_beta=1.2), which restores the MRSF-TDDFT
# bright/dark state ordering. The lc_ground_state flag turns on the
# long-range-corrected ROKS reference; the trust mixer is recommended for
# the cam_beta>1 SCC.
[input]
system=
   6   0.000000000   0.000000000   0.000000000
   6   0.000000000   0.000000000   1.240000000
charge=0
runtype=energy
basis=sto-3g
functional=
method=dftb

[guess]
type=huckel

[scf]
type=rohf
multiplicity=3

[tdhf]
type=mrsf
nstate=3

[dftb]
backend=native
type=mrsf
parameter_path=params
lc_ground_state=true
lc_gamma=erf
omega=0.25
cam_beta=1.2
scc_mixer=trust
