# Continuation companion for H2CO-water_BHHLYP-MRSF-NAMD-QMMM.oqp.
# Run the producer first; openqp --run_tests schedules this file after it and
# reuses the same isolated project directory, checkpoint, and trajectory. The
# checkpoint at step 2 is continued through step 3.
mrsf(nstate=2)/bhhlyp/6-31g*
namd(T0,scheme=custom,tdc=npi,rescale=isotropic,thrshe=0.367493,frustrated=reflect,nstep=3,substep=50,seed=3,nacme_check=baeck_an,nacme_policy=warn,nacme_policy_invariant_tol=1e-09,nacme_policy_abs_tol=0.0002,nacme_policy_rel_tol=0.8,nacme_policy_consecutive=2,nve_policy_abs_tol=0.004,nve_policy_step_tol=0.0008,nve_policy_transition_tol=2e-06,nve_policy_consecutive=2,trajectory_interval=2,restart_interval=2,trajectory_file="H2CO-water.namd.trj",restart_file="H2CO-water.namd.restart.npz",restart=true,trivial=true)
qmmm(pdb_file="formaldehyde_water.pdb",forcefield_files="formaldehyde.xml tip3p.xml",qm_atoms="0-3")
droplet(enabled=true,radius=3.3,water_resnames="HOH,WAT",max_penetration=3.0)
solute_com(enabled=true,force_constant=2.0,atoms="0-3")
geom="../geometries/CH2O-2bc62dda4b8a.xyz"
