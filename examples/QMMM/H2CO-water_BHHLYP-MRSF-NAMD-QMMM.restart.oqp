# Continuation companion for H2CO-water_BHHLYP-MRSF-NAMD-QMMM.oqp.
# Run the producer first; openqp --run_tests schedules this file after it and
# reuses the same isolated project directory, checkpoint, trajectory, and
# NACME validation record. The checkpoint at step 2 is continued through step 3.
mrsf(nstate=2)/bhhlyp/6-31g*
namd(T0,nstep=3,dt=0.5,substep=50,init_temp=300,velocity=maxwell,seed=3,rng_stream=1,first_hop_step=1,nacme_check=baeck_an,ba_gap_max=0.0734986443513,nacme_gate=warn,nacme_gate_invariant_tol=1.0e-9,nacme_gate_abs_tol=2.0e-4,nacme_gate_rel_tol=0.8,nacme_gate_consecutive=2,nve_gate=warn,nve_gate_abs_tol=4.0e-3,nve_gate_step_tol=8.0e-4,nve_gate_transition_tol=2.0e-6,nve_gate_consecutive=2,trajectory_interval=2,restart_interval=2,trajectory_file="H2CO-water.namd.trj",nacme_audit_file="H2CO-water.namd.nacme.tsv",restart_file="H2CO-water.namd.restart.npz",restart=true,decoherence=edc,trivial=true,soc=false)
guess(type=huckel)
qmmm(pdb_file="formaldehyde_water.pdb",forcefield_files="formaldehyde.xml tip3p.xml",qm_atoms="0-3",cutoff=NoCutoff,embedding=electrostatic)
geom="../geometries/CH2O-2bc62dda4b8a.xyz"
