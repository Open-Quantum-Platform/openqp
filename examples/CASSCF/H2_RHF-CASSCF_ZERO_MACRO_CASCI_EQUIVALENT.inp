# RHF/STO-3G/CASSCF scaffold ENERGY of H2 in the full CAS(2e,2o) space.
# This explicitly requests zero macro iterations, so no orbital update is
# performed. The calculation is CASCI-equivalent and should reproduce the
# native CASCI/FCI reference energy for this full active space.
#
# This is not a native orbital-optimized or accepted CASSCF calculation.
[input]
system=
   H   0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   0.740000000
charge=0
runtype=energy
basis=sto-3g
method=casscf

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=60
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=0
max_det=1000
max_memory=256

[ci]
nroot=1
solver=dense
eig_tol=1.0e-10
integral_backend=native
integral_cutoff=5.0e-11
davidson_maxiter=100

[casscf]
max_macro_iterations=0
