# Analytic SF-TDDFT gradient of HOBr from a UHF triplet reference, with the LANL2DZ effective core
# potential on Br (spherical basis). Exercises the ECP derivative term of the UHF SF relaxed
# density: the UHF Z-vector density is contracted with the shared ECP derivative integrals.
# Against five-point central finite differences (h = 1e-3 bohr, symmetry off, [tdhf]
# conv=1e-12 zvconv=1e-14) the analytic state gradient agrees to 6.8e-8 Ha/Bohr for the UHF
# reference and 2.2e-9 for ROHF; the ground-state DFT gradient agrees to 7.4e-9 (UHF) and
# 7.3e-9 (ROHF); with the native ECP integrals the UHF SF state gradient agrees to 6.8e-8.
# With the unpatched libecpint 1.0.7 integrals the shared ECP derivative left a 1e-5 O-Br
# residual in all four.
# Bent HOBr is used because the triplet UHF solution
# of linear HBr breaks the pi degeneracy and does not converge reliably at displaced geometries.
[input]
system=
 O    0.000000000   0.000000000   0.000000000
 H    0.970000000   0.000000000   0.000000000
 Br  -0.411700000   1.783100000   0.000000000
charge=0
runtype=grad
method=tdhf
functional=bhhlyp
basis=lanl2dz
ispher=true

[guess]
type=sap

[scf]
type=uhf
multiplicity=3
conv=1e-10
maxit=200

[dftgrid]
rad_npts=96
ang_npts=302
pruned=

[tdhf]
type=sf
nstate=3
conv=1e-10
zvconv=1e-10

[properties]
grad=1
