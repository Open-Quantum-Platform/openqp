# DFT/LANL2DZ/BHHLYP/RHF/GRADIENT of SiO with a Si effective core potential.
# The O p shells lie 1.51 Angstrom from the Si ECP. With the unpatched libecpint
# 1.0.7 integrals the analytic gradient differed from central finite
# differences of the energy by 1.2e-4 Ha/bohr; the reference gradient agrees
# with five-point finite differences (step 1e-3 bohr) to 1e-9 Ha/bohr.
[input]
system=
   14   0.000000000   0.000000000   0.000000000
    8   0.000000000   0.000000000   1.510000000
charge=0
runtype=grad
functional=bhhlyp
basis=lanl2dz
ispher=true
method=hf

[guess]
type=sap

[scf]
type=rhf
multiplicity=1
conv=1e-10
maxit=200

[dftgrid]
rad_npts=96
ang_npts=302
pruned=

[symmetry]
enabled=false
