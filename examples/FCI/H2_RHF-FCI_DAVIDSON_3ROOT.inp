# RHF/STO-3G/FCI/ENERGY of H2, three roots with the Davidson solver.
# Covers nroot, solver=davidson, eig_tol, integral_cutoff, max_memory, and davidson_maxiter.
[input]
system=
   H   0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   0.740000000
charge=0
runtype=energy
basis=sto-3g
method=fci

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=60
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[fci]
nroot=3
max_det=1000
max_memory=256
eig_tol=1.0e-10
integral_backend=native
integral_cutoff=5.0e-11
solver=davidson
davidson_maxiter=100
