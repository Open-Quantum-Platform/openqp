# SSR(2,2)-BHHLYP energy of H2O from RKS orbitals with DIIS, S1 target
# REKS(2,2) ensemble DFT (Filatov): [scf] type=reks selects the SA-REKS(2,2)
# coupling-operator SCF; reks_type=2si/3si adds the SSR state interaction and
# reks_target selects the reported state (sa, s0, s1).
# Reference: GAMESS-US REKS (Filatov/Lee) on the same geometry, see
# tests in the OpenQP REKS validation record (2026-09-18).
[input]
system=
   8   0.00000000     0.00000000     0.00000000
   1   1.00000000     0.50000000     0.00000000
   1  -1.00000000     0.50000000     0.00000000
charge=0
runtype=energy
basis=6-31g*
functional=bhhlyp
method=hf

[guess]
type=huckel

[scf]
type=reks
multiplicity=1
reks_type=2si
reks_target=s1
reks_wpps=0.5
reks_shift=0.3
reks_diis=True
init_scf=rks
maxit=100
conv=1e-7

[dftgrid]
rad_npts=96
ang_npts=302
pruned=none
