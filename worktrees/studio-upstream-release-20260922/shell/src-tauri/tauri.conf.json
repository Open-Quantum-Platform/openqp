{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OQP Studio",
  "version": "0.2.3",
  "identifier": "org.openqp.studio",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OQP Studio",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#1b1e24",
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
    "bundle": {
      "active": true,
      "targets": "all",
      "copyright": "Copyright (c) Open Quantum Inc. and contributors. All rights reserved.",
      "licenseFile": "../../LICENSE",
      "externalBin": ["binaries/oqp-studio-backend"],
      "macOS": {
        "files": {
          "Frameworks": "binaries/oqp-studio-backend-runtime"
        }
      },
      "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
