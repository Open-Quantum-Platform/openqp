# RHF/STO-3G/MRMP2 of linear H4, ground state, CASCI reference.
# Single-state multireference Moller-Plesset PT2 (Hirao): the QDPT-family label
# for the diagonal-Fock (MP-like) H0 -- numerically identical to method=caspt2
# with the default h0=fock (E2 = -0.0184952 vs OpenMolcas CIonly CASPT2).
[input]
system=
   H   0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   0.740000000
   H   0.000000000   0.000000000   1.480000000
   H   0.000000000   0.000000000   2.220000000
charge=0
runtype=energy
basis=sto-3g
method=mrmp2

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
# Tight SCF: the default conv=1e-6 stops on a chaotically oscillating C-DIIS
# trajectory, so ULP-level run-to-run noise from the threaded Fock build
# (dynamic shell-pair schedule) leaves the RHF orbitals differing by ~1e-6
# between runs and moves the printed PT2 digits.  conv=1e-10 pins them.
conv=1.0e-10
maxit=80
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=1
orbital_source=rhf
sort_orbitals=energy
max_det=5000
max_memory=512

[ci]
nroot=1
solver=dense
eig_tol=1.0e-10
integral_backend=native

[pt2]
reference=casci
ipea_shift=0.0
edshft=0.0
semi_canonical=true
