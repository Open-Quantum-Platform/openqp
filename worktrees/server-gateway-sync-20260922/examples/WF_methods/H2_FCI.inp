# RHF/STO-3G/FCI/ENERGY of H2.
# Compact option-complete input for the native determinant FCI path.
[input]
system=
   H   0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   0.740000000
charge=0
runtype=energy
basis=sto-3g
method=fci

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=60
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[fci]
nroot=3
active_electrons=0
active_orbitals=0
frozen_core=0
max_det=1000
max_memory=256
eig_tol=1.0e-10
integral_backend=native
integral_cutoff=5.0e-11
solver=davidson
davidson_maxiter=100
davidson_subspace=6
target_spin=any
print_ci_vectors=false
ci_print_threshold=5.0e-2
save_ci_vectors=false
save_rdm=false
