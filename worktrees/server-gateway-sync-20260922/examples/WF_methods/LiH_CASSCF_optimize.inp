# RHF/STO-3G/CASSCF geometry optimization of LiH with the analytic
# state-specific nuclear gradient.
#
# [casscf] root=0 selects the physical CASSCF state.  The analytic gradient is
# published as one array row, so every state-specific geometry driver must use
# [optimize] istate=0 even when a higher physical root is selected.
[input]
system=
   Li  0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   1.600000000
charge=0
runtype=optimize
basis=sto-3g
method=casscf

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
conv=1.0e-10
maxit=80
forced_attempt=3
save_molden=false

[cas]
active_electrons=2
active_orbitals=2
frozen_core=1
orbital_source=rhf
max_det=5000
max_memory=512

[ci]
nroot=1
solver=dense
eig_tol=1.0e-10
integral_backend=native
target_spin=singlet

[casscf]
max_macro_iterations=50
root=0
converger=trah
gradient_norm_tol=1.0e-8
energy_decrease_tol=1.0e-10
step_norm_tol=1.0e-8
max_rotation_norm=2.0e-1
canonicalize=true

[optimize]
lib=oqp
istate=0

[oqp]
coordsys=tric
trust=0.2
