# RHF/STO-3G/CASSCF/ENERGY of LiH in a frozen-core CAS(2e,2o) space.
# Compact option-complete input for state-specific native CASSCF.
[input]
system=
   Li  0.000000000   0.000000000   0.000000000
   H   0.000000000   0.000000000   1.600000000
charge=0
runtype=energy
basis=sto-3g
method=casscf

[guess]
type=hcore

[scf]
multiplicity=1
type=rhf
maxit=80
forced_attempt=3
save_molden=false

[properties]
scf_prop=

[cas]
active_electrons=2
active_orbitals=2
frozen_core=1
active_orbital_indices=
core_orbital_indices=
orbital_source=rhf
orbital_file=
localize=none
sort_orbitals=energy
max_det=5000
max_memory=512

[ci]
nroot=1
solver=dense
eig_tol=1.0e-10
davidson_maxiter=100
davidson_subspace=0
integral_backend=native
integral_cutoff=5.0e-11
spin_adapted=false
target_spin=any
root_tracking=energy
print_ci_vectors=false
ci_print_threshold=5.0e-2
save_ci_vectors=false
save_rdm=false

[casscf]
max_macro_iterations=50
root=0
gradient_norm_tol=1.0e-12
energy_decrease_tol=0.0
step_norm_tol=0.0
max_rotation_norm=2.0e-1
optimizer=newton
max_function_evaluations=0
diagnostic_report=false
diagnostic_report_file=
diagnostic_root=0
diagnostic_max_iterations=1
diagnostic_gradient_norm_tol=1.0e-8
diagnostic_max_rotation_norm=5.0e-2
diagnostic_benchmark_reference_file=
diagnostic_benchmark_tolerance=1.0e-5
diagnostic_benchmark_required=false
