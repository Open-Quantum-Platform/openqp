# SOC-NAMD (intersystem crossing) with ESPF QM/MM embedding.
#
# QM  = formaldehyde (H2CO, atoms 0-3), MRSF-TDDFT/BHHLYP/6-31G* on a triplet
#       ROHF reference; hopping is on the spin-adiabatic manifold (ns singlets +
#       3*nt triplet Ms sublevels, here 2 + 3*2 = 8 states).
# MM  = 5 TIP3P waters, handled by OpenMM (NoCutoff, non-periodic cluster).
#
# Minimal demonstration: nstep=1 runs a single nuclear step (one embedded
# singlet + triplet MRSF + SOC evaluation with the weighted-MCH diagonal
# gradient) so it finishes quickly.  The final step writes a packed trajectory,
# restart checkpoint, and runnable restart manifest while the default NVE gate
# records an energy-conservation warning instead of stopping the run.  Requires
# the optional OpenMM backend and the companion files formaldehyde_water.pdb,
# formaldehyde.xml, tip3p.xml (read relative to this file).  It is part of
# `openqp --run_tests all`, and is reported SKIPPED when OpenMM is not installed.
[input]
system=
   6   0.000000   0.000000   0.000000
   8   0.000000   0.000000   1.203000
   1   0.000000   0.943000  -0.589000
   1   0.000000  -0.943000  -0.589000
charge=0
runtype=namd
basis=6-31g*
functional=bhhlyp
method=tdhf
qmmm_flag=True

[guess]
type=huckel

[scf]
multiplicity=3
type=rohf

[tdhf]
type=mrsf
nstate=2
multiplicity=3

[properties]
grad=1

[md]
nstep=1
dt=0.25
active=5
substep=50
init_temp=300
velocity=maxwell
decoherence=edc
trivial=True
soc=True
# Baeck-An is a same-spin diagnostic; SOC propagation stores the full complex
# spin-adiabatic overlap/TDC in the packed trajectory instead.
nacme_check=off
trajectory_interval=1
restart_interval=1
trajectory_file=H2CO-water-SOC.namd.trj
restart_file=H2CO-water-SOC.namd.restart.npz

[qmmm]
pdb_file=formaldehyde_water.pdb
forcefield_files=formaldehyde.xml tip3p.xml
qm_atoms=0-3
cutoff=NoCutoff
embedding=electrostatic
